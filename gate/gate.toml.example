# tmwa-gate configuration; names and defaults follow tmwa's
# login_conf / char_conf / inter_conf where they still apply.

[gate]
# The single client-facing listen address.
listen = "0.0.0.0:6901"
# Advertised to clients in 0x0069 (char select). The 0x0071 map
# reply carries the registered map server address instead.
public_ip = "127.0.0.1"
public_port = 6901
# SQLite database.
db = "gate.db"
# tmwa-format GM file; reloaded when its mtime changes (every
# gm_account_filename_check_timer seconds).
gm_account_file = "save/gm_account.txt"
online_txt = "online.txt"
online_html = "online.html"
# Pace for `admin drain` evacuations, in clients/second: each
# evacuated player lands as a fresh login on the destination map
# server, so the bound keeps a large drain absorbable. 0 disables
# pacing; `admin drain --rate` overrides per call.
evacuate_per_second = 50

[map]
# tmwa-map connects here (kept localhost-only by default).
listen = "127.0.0.1:6121"
userid = "s1"
password = "p1"
# NOTE: TCP clients connect to the map server directly now. The
# `map_ip` / `map_port` the map registers with (0x2af8, from its
# conf/tmwa-map.conf) must be reachable by players: it is sent to
# clients verbatim in the 0x0071 char-select reply and in 0x0092
# map transfers, unless the client is covered by [lan] lan_subnet
# below. WebSocket clients are unaffected (the gate still relays
# their map stage).

[login]
new_account = true
update_host = ""
min_level_to_connect = 0
order = "deny_allow"
allow = []
deny = []
conn_limit_enable = true
conn_limit_interval = 5
gm_account_filename_check_timer = 15

[char]
server_name = "The Mana World"
max_connect_user = 0
start_point = "001-1.gat,273,354"
# Allowed letters for new character names (same set as the stock
# char_athena.conf; concatenated).
char_name_letters = ["$ &'()*+,-.", "0123456789", ";<=>?",
                     "ABCDEFGHIJKLMNOPRSTQUVWXYZ", "\\^_`",
                     "abcdefghijklmnoprstquvwxyz"]
online_gm_display_min_level = 20
online_refresh_html = 20
max_hair_style = 20
max_hair_color = 11
min_stat_value = 1
max_stat_value = 9
total_stat_sum = 30
min_name_length = 4
char_slots = 9

[inter]
party_share_level = 10

[lan]
# lan_support.conf semantics: a client whose IP is covered by
# lan_subnet is sent lan_map_ip in the 0x0071 reply instead of the
# map's advertised address; the registered port is kept. tmwa
# IP4Mask syntax: "a.b.c.d" (/32), "a.b.c.d/n", "a.b.c.d/e.f.g.h",
# or the "a.b." trailing-dot shorthand.
lan_subnet = "127.0.0.1"
lan_map_ip = "127.0.0.1"

# Seamless map restart:
# hold_timeout_secs = 180
# hold_message = "Server restarting, please wait."
# admin_socket = "tmwa-gate.sock"

# HTTP API + WebSocket listener:
# [http]
# listen = "127.0.0.1:8080"          # serves {base}/server, {base}/account
# base = "/api/tmwa"                 # tmw-api compatible prefix
# ws_path = "/tmwa"                  # WebSocket client endpoint
# captcha = true                     # verify X-CAPTCHA-TOKEN (false for dev)
# recaptcha_secret = ""
# mailer_from = "The Mana World <noreply@themanaworld.org>"
# sendmail = "/usr/sbin/sendmail"
# reset_url = "https://themanaworld.org/reset#"
# name = "The Mana World"
# url = "https://themanaworld.org/"
# trusted_proxies = ["127.0.0.1"]    # peers allowed to send X-Forwarded-For
# max_connections = 1000             # TCP + WS client cap
